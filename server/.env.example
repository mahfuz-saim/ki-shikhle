# ---------------------------------------------------------------------------
# server/.env — copy with `npm run setup` (generates secrets) or by hand.
# Local dev works with ONLY the values in "Required" below; everything under
# "Optional" degrades gracefully when left empty (see README → Local dev).
# ---------------------------------------------------------------------------

# ===== Required (local defaults are already correct for docker compose) =====
NODE_ENV=development
PORT=5000
# Postgres. `npm run setup` + `docker compose up -d` gives you this exact URL.
DATABASE_URL=postgresql://kishikhle:kishikhle_dev_password@localhost:5432/learntrack
# Comma-separated browser origins (Vercel production + preview URLs in prod)
CLIENT_ORIGIN=http://localhost:3000
# In development these may be left as-is (dev values are used automatically).
# In production they are REQUIRED (>=16 chars) and must be random.
JWT_ACCESS_SECRET=dev_access_secret_kishikhle_local_only_0001
JWT_REFRESH_SECRET=dev_refresh_secret_kishikhle_local_only_0001
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
PASSWORD_PEPPER=dev_pepper_local_only
TRIAL_DAYS=15

# ===== Optional: AI (Anthropic) — without a key the API returns mock responses =====
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-3-5-haiku-latest
AI_MODEL_SMART=claude-sonnet-4-20250514
# AI_MONTHLY_BUDGET_USD=50

# ===== Optional: email — without SMTP_URL emails are printed to the console =====
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# ===== Optional: file storage for note uploads =====
# local (default): writes to server/uploads, served via authenticated /api/v1/files/:key
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./uploads
# s3|r2: any S3-compatible store — Cloudflare R2, AWS S3, Backblaze B2, MinIO, Spaces.
# Requires the two @aws-sdk packages (optionalDependencies) and:
# STORAGE_DRIVER=r2
# R2_BUCKET=kishikhle-notes
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=            # only if the bucket is public / behind a CDN
# R2_FORCE_PATH_STYLE=true  # MinIO only

# ===== Optional: scheduled jobs =====
# Set false to disable in-process node-cron (e.g. on serverless) and use the HTTP trigger.
ENABLE_CRON=true
# Shared secret for POST /api/v1/jobs/run (Cloudflare Cron Trigger / external scheduler)
# CRON_SECRET=

# ===== Database driver (Cloudflare Workers only) =====
# Node/VPS/Docker: leave unset (Prisma's default engine).
# Cloudflare Workers: set DATABASE_ADAPTER=pg so Prisma uses @prisma/adapter-pg
# (node-postgres over Hyperdrive) — the Rust engine can't run on Workers.
# DATABASE_ADAPTER=pg

# ===== Networking =====
TRUST_PROXY=true
# COOKIE_DOMAIN=            # e.g. .kishikhle.com if API and web share a parent domain
